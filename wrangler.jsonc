{
  "name": "font-tai-cloudflare",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "font_tai_db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FONT_BUCKET",
      "bucket_name": "font-tai-files"
    }
  ]
}
